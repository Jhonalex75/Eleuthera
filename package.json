{
  "name": "afry-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node scripts/seed-firestore.mjs",
    "rules:open": "firebase deploy --only firestore:rules --config firebase.seed.json",
    "rules:lock": "firebase deploy --only firestore:rules --config firebase.json",
    "publish": "npm run rules:open && npm run seed && npm run rules:lock",
    "fix:native": "node scripts/fix-native-bindings.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
