{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "eleuthera",
      "public": "out",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        }
      ]
    }
  ]
}
